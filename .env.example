# RISE website — environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill it in. Never commit real
# secrets — only this example file is tracked. The app reads from Postgres
# (Drizzle ORM) and Supabase Storage; both are required to run. Resend (email)
# and Turnstile (spam protection) swap in later behind their seams.

# Postgres connection (REQUIRED). Drizzle over a direct connection to Supabase's
# transaction pooler (port 6543), used for submissions, blog posts, and the
# notifications audit log. Prepared statements are disabled, which the pooler
# requires. Keep this server-side only: never prefix it with NEXT_PUBLIC_ and
# never expose it to the browser.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# Direct/session connection (port 5432), used only by drizzle-kit for migrations
# (`npm run db:migrate`) and the seed/setup scripts. Not used by the running app.
# DIRECT_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# Supabase Storage for blog images. SUPABASE_URL is the public project URL; the
# SERVICE_ROLE key bypasses RLS and is SERVER-ONLY — never NEXT_PUBLIC_.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# Absolute base URL for canonical tags, sitemap, robots, and OpenGraph metadata.
# Public (NEXT_PUBLIC_) and read at build time. Defaults to the production domain.
# NEXT_PUBLIC_SITE_URL=https://risedevinitiative.org

# Recipient recorded on new-submission notifications.
# RISE_NOTIFY_EMAIL=

# Secret that signs admin session cookies. The admin area is disabled (404)
# when this is unset. Use a high-entropy value (32+ random characters); it is
# independent of any account password, so rotating a password does not log
# everyone out, and rotating this secret invalidates all sessions.
# ADMIN_SESSION_SECRET=
#
# Admin accounts (with per-account passwords and roles) are NOT set here; create
# the first one from the command line, then manage the rest in the admin UI:
#   node --env-file-if-exists=.env.local scripts/create-admin.mjs
#   (or: npm run create-admin)
# The first/bootstrap account should be a superadmin (the default).
